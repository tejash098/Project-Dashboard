# Server environment variables.
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# ── Server ──
# HTTP port the API listens on (optional; defaults to 5000).
PORT=5000

# ── Database ──
# MongoDB connection string (required). For Atlas, use a mongodb+srv URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# ── Auth ──
# Secret used to sign JWTs (required). Use a long, random string.
JWT_SECRET=replace-with-a-long-random-secret

# ── Admin seeding (optional) ──
# When both are set, a bootstrap admin is created on first start if none exists.
# seedAdmin warns and skips when these are unset.
ADMIN_USERNAME=admin-username
ADMIN_PASSWORD=admin-password

# ── Cloudinary (required) ──
# Credentials for uploading Contact-form feedback images. Found in your
# Cloudinary dashboard. The API secret must stay server-side only.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Redis (optional — cache for GitHub language stats) ──
# When unset, the server boots normally and the language-stats endpoint
# fetches GitHub directly on every request (no caching).
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=your-host.db.redis.io
REDIS_PORT=13825

# ── Rate limiting (optional — defaults to 15 req / 60s per IP) ──
# Redis-backed per-IP rate limiter. Adjust if needed.
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW=60

# ── GitHub (optional — defaults to the portfolio account) ──
# Account the language-stats endpoint aggregates. Keep in sync with
# GITHUB_USERNAME in client/src/config/github.js.
GITHUB_USERNAME=your-github-profile-username
