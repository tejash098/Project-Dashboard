# Server environment variables.
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# ── Server ──
# HTTP port the API listens on (optional; defaults to 5000).
PORT=5000

# ── Database ──
# MongoDB connection string (required). For Atlas, use a mongodb+srv URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# ── Auth ──
# Secret used to sign JWTs (required). Use a long, random string.
JWT_SECRET=replace-with-a-long-random-secret

# ── Admin seeding (optional) ──
# Bootstrap admin, created on first start when both are set.
ADMIN_USERNAME=admin-username
ADMIN_PASSWORD=admin-password

# ── Cloudinary (required) ──
# Credentials for feedback image uploads and project preview screenshots.
# The API secret must stay server-side only.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Project preview screenshots (optional) ──
# Microlink key. Leave unset unless you pay for Microlink Pro — setting it
# switches to the pro host, which rejects requests not on a paid plan.
# MICROLINK_API_KEY=only-if-you-have-a-paid-plan

# ── Redis (optional) ──
# Cache for GitHub language stats and the rate-limit counters. When unset,
# every request behaves like a cache miss.
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=your-host.db.redis.io
REDIS_PORT=13825

# ── Rate limiting (optional) ──
# Global per-IP budget (defaults to 15 req / 60s).
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW=60

# ── GitHub (optional) ──
# Account the language-stats endpoint aggregates (defaults to tejash098).
# Keep in sync with GITHUB_USERNAME in client/src/config/github.js.
GITHUB_USERNAME=your-github-profile-username

# ── Chatbot (optional) ──
# Gemini API key for POST /api/chat. When unset, only that endpoint degrades.
GEMINI_API_KEY=your-gemini-key

# Models to try, in order, as a comma-separated list (optional). The server
# falls through to the next one when a model is out of quota, overloaded, or
# retired. This is mainly a quota strategy: on the free tier each model has its
# OWN per-minute and per-day allowance, so two models is two budgets.
#
# The defaults are both lite-tier, where the highest request-per-minute limits
# are, ordered fastest-first by measured latency:
#   gemini-3.5-flash-lite  ~1.5s
#   gemini-3.1-flash-lite  ~6.5s
# Every id must support structured output, which the follow-up questions need.
# Avoid gemini-2.5-flash-lite (404s: "no longer available to new users") and
# gemini-3.5-flash (15-19s, and frequently 503 "high demand").
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Public origin of this API, cited as the reference-document URL in the chatbot
# prompt (optional; defaults to http://localhost:5000).
# PUBLIC_BASE_URL=https://your-api-host.example.com

# Timeouts in milliseconds (optional). CHAT_TIMEOUT_MS caps one model attempt
# before the server moves to the next model; CHAT_TOTAL_TIMEOUT_MS caps the
# whole cascade and is kept well inside the client's 90s axios timeout.
# CHAT_TIMEOUT_MS=15000
# CHAT_TOTAL_TIMEOUT_MS=30000
